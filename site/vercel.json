{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "astro",
  "installCommand": "npm install",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/**/*.js": { "maxDuration": 10, "includeFiles": "dist/c/index.html" }
  },
  "rewrites": [
    { "source": "/c/:slug", "destination": "/api/og-claim?slug=:slug" },
    { "source": "/c/:slug/:rest*", "destination": "/c/index.html" }
  ],
  "headers": [
    {
      "source": "/_astro/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/api/config",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=60" }]
    },
    {
      "source": "/api/stats",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=15" }]
    }
  ]
}
