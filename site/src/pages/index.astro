---
import { CONTACT_TEXT } from '../lib/contact';
import Base from '../layouts/Base.astro';

const allProducts = [
  { key: 'tweet', name: 'Tweet Trophy', price: '$29', line: 'Your tweet in raised letters, with the like count that proves it happened.' },
  { key: 'milestone', name: 'Milestone Plaque', price: '$49', line: 'One number you worked for. Revenue, MRR, subscribers, stars, followers.' },
  { key: 'fullcolour', name: 'Full-Colour Receipt', price: '$89', line: 'Your actual screenshot, printed in full colour on a desk stand.' },
  { key: 'team', name: 'Team Pack', price: '$249', line: "Ten plaques with your team's name, for the people who got you there." },
];
// Full-Colour stays hidden until Craftcloud fulfilment works (set PUBLIC_FULLCOLOUR_ENABLED=1).
const products = allProducts.filter((p) => p.key !== 'fullcolour' || import.meta.env.PUBLIC_FULLCOLOUR_ENABLED === '1');
const steps = [
  'Describe it, drop a photo, or paste a tweet.',
  'Turn it around in 3D, ask for changes, pick a size and colour.',
  'We print it in tough PETG and ship it to you. US only for now.',
];
const faq = [
  { q: 'Who makes these?', a: 'AI agents design every piece from your description or photo. A print farm in the US prints it and ships it to you.' },
  { q: 'How is the price worked out?', a: 'From your model: we measure how much plastic it needs at the size you pick, add printing and US shipping, and show you one total before you pay.' },
  { q: 'How long does it take?', a: 'Trophies and plaques ship in 2 to 7 days. Custom figures are made to order and ship in 2 to 3 weeks.' },
  { q: 'What are they made of?', a: 'Trophies and plaques are tough PETG plastic. Full-colour pieces are printed in colour resin or sandstone.' },
  { q: 'What if it arrives broken or wrong?', a: `We reprint it or refund you. Contact us at ${CONTACT_TEXT}.` },
  { q: 'Are you affiliated with X, YouTube or Stripe?', a: "No. We're an independent studio. We print what you send us." },
];
---
<Base>
  <section class="wrap hero">
    <div class="hero-copy fade-up">
      <h1>Describe it. We 3D print it.</h1>
      <p class="hero-sub">Type any idea or drop a photo. Your pet, your mascot, your trophy, your weird little dream object. You see it in 3D in about 30 seconds, tweak it, and we print it and ship it to you.</p>
      <form class="hero-form" id="hero-form" novalidate>
        <label class="sr-only" for="hero-input">Describe what you want printed, or paste a tweet link</label>
        <textarea class="input" id="hero-input" name="q" rows="3" maxlength="500" autocomplete="off"
          placeholder="my golden retriever wearing a graduation cap"></textarea>
        <div class="hero-row">
          <label class="btn photo-btn" for="hero-photo"><span id="photo-label">+ Add a photo</span></label>
          <input id="hero-photo" type="file" accept="image/png,image/jpeg,image/webp" hidden />
          <button class="btn btn-primary" id="hero-go" type="submit">Make my 3D model</button>
        </div>
        <div class="chips" id="chips">
          <button type="button" class="chip">a tiny astronaut cat planting a flag on a pizza</button>
          <button type="button" class="chip">our startup mascot, a robot holding a trophy</button>
          <button type="button" class="chip">a dragon curled around a coffee mug</button>
        </div>
        <p class="err" id="hero-err" role="alert"></p>
      </form>
      <p class="small muted mono">Free 3D preview. You only pay if you want it printed. Paste a tweet link to get a Tweet Trophy instead.</p>
    </div>
    <div class="hero-object fade-up d2">
      <div class="stage hero-stage" id="hero-stage">
        <div class="stage-empty" id="hero-msg">Loading preview…</div>
        <img id="hero-concept" alt="" hidden />
      </div>
      <p class="mono small muted" id="hero-caption">Example: “my golden retriever wearing a graduation cap”. <a href="/r?id=demo">Open it →</a></p>
    </div>
  </section>

  <section class="wrap section" aria-labelledby="pick-h">
    <h2 id="pick-h">Or start from a preset</h2>
    <p class="muted preset-sub">Trophies for your wins, designed from the real thing: your actual tweet, your actual number.</p>
    <ul class="shelf" role="list">
      {products.map((p) => (
        <li>
          <a class="item" href={`/make?product=${p.key}`}>
            <div class="item-img" data-snap={p.key}>
              <span class="stage-empty">{p.name}</span>
            </div>
            <div class="item-meta">
              <h3>{p.name}</h3>
              <span class="price">{p.price}</span>
            </div>
            <p class="muted">{p.line}</p>
          </a>
        </li>
      ))}
    </ul>
    <p class="mono founding">The first 100 pieces are numbered, #001 to #100. <span id="founding-left" hidden><span data-stat="founding"></span> left.</span></p>
  </section>

  <section class="wrap section" aria-labelledby="how-h">
    <h2 id="how-h">How it works</h2>
    <ol class="how" role="list">
      {steps.map((s, i) => (
        <li><span class="num">{i + 1}</span><p>{s}</p></li>
      ))}
    </ol>
  </section>

  <section class="wrap section faq" aria-labelledby="faq-h">
    <h2 id="faq-h">FAQ</h2>
    <div class="faq-list">
      {faq.map((f) => (
        <details>
          <summary>{f.q}</summary>
          <p>{f.a}</p>
        </details>
      ))}
    </div>
  </section>
</Base>

<style>
  .hero {
    display: grid; grid-template-columns: 1fr; gap: 1.5rem;
    padding-block: 1.5rem 2.5rem; align-items: center;
  }
  .hero h1 { font-size: clamp(3.25rem, 11vw, 7.5rem); font-weight: 900; line-height: 0.9; max-width: 11ch; }
  .hero-sub { margin-top: 1.25rem; max-width: 46ch; font-size: 1.125rem; }
  .hero-form { display: grid; gap: 0.625rem; margin: 1.5rem 0 0.625rem; max-width: 640px; }
  .hero-form .input { min-height: 96px; font-size: 1.0625rem; resize: vertical; }
  .hero-form .btn { min-height: 56px; }
  .hero-row { display: grid; grid-template-columns: auto 1fr; gap: 0.5rem; }
  .photo-btn { cursor: pointer; }
  .chips { display: flex; flex-wrap: wrap; gap: 0.375rem; }
  .chip { font: 400 0.8125rem/1.2 var(--mono); padding: 0.45rem 0.7rem; border: 1px solid var(--rule); background: var(--paper-hi); cursor: pointer; border-radius: 999px; }
  .chip:hover { border-color: var(--ink); }
  .hero-stage { border: 2px solid var(--ink); background: radial-gradient(ellipse at 50% 40%, #fbf9f4 0%, var(--paper) 70%); }
  .hero-stage img { position: absolute; inset: 10%; width: 80%; height: 80%; object-fit: contain; opacity: 0.6; }
  .preset-sub { margin: -0.75rem 0 1.5rem; max-width: 60ch; }
  .hero-object { width: 100%; }
  .hero-object .stage { aspect-ratio: 1 / 0.85; }
  @media (min-width: 960px) {
    .hero { grid-template-columns: 1.05fr 1fr; gap: 2rem; padding-block: 3rem 4rem; min-height: calc(100dvh - 64px - 4rem); }
    .hero-object .stage { aspect-ratio: 1 / 1; }
  }

  .strip { background: var(--ink); color: var(--paper); font: 400 0.9375rem/1.4 var(--mono); }
  .strip-inner { display: flex; flex-wrap: wrap; gap: 0.5rem 2rem; align-items: center; padding-block: 0.875rem; }
  .strip-inner p:first-child { flex: 1 1 22rem; }
  .strip-stats { display: flex; gap: 1.5rem; font-weight: 700; }
  .strip-stats [data-stat='revenue'] { color: #ff6b5e; }
  .strip a { font-weight: 700; min-height: 44px; display: inline-flex; align-items: center; }

  .section { padding-top: clamp(3rem, 8vw, 6rem); }
  .section h2 { font-size: clamp(2.25rem, 6vw, 3.75rem); margin-bottom: 1.5rem; }

  .shelf {
    list-style: none; margin: 0 calc(var(--pad) * -1); padding: 0 var(--pad) 1rem;
    display: grid; grid-auto-flow: column; grid-auto-columns: minmax(250px, 78%);
    gap: 1rem; overflow-x: auto; scroll-snap-type: x mandatory; scrollbar-width: thin;
  }
  .shelf li { scroll-snap-align: start; }
  @media (min-width: 760px) { .shelf { grid-auto-columns: minmax(260px, 40%); } }
  @media (min-width: 1100px) { .shelf { grid-auto-flow: row; grid-template-columns: repeat(4, 1fr); overflow: visible; } }
  .item { display: grid; gap: 0.625rem; text-decoration: none; height: 100%; }
  .item:hover h3 { text-decoration: underline; text-decoration-thickness: 2px; }
  .item-img {
    position: relative; aspect-ratio: 4 / 5; border-bottom: 2px solid var(--ink);
    background: var(--paper-hi);
  }
  .item-img img { width: 100%; height: 100%; object-fit: contain; }
  .item-img[data-ready='1'] .stage-empty { display: none; }
  .item-meta { display: flex; justify-content: space-between; align-items: baseline; gap: 1rem; }
  .item h3 { font-size: 1.75rem; }
  .price { font: 900 1.75rem/1 var(--display); color: var(--red); }
  .item p { font-size: 0.9375rem; }
  .founding { margin-top: 1rem; font-size: 0.9375rem; }

  .how { list-style: none; margin: 0; padding: 0; display: grid; gap: 1.5rem; }
  .how li { display: grid; grid-template-columns: auto 1fr; gap: 1rem; align-items: start; padding-top: 1rem; border-top: 2px dotted var(--rule); }
  .how .num { font: 900 4.5rem/0.8 var(--display); color: var(--red); min-width: 2.5rem; }
  .how p { font-size: 1.125rem; max-width: 34ch; }
  @media (min-width: 860px) { .how { grid-template-columns: repeat(3, 1fr); gap: 2rem; } .how li { grid-template-columns: 1fr; } }

  .faq-list { max-width: 760px; border-top: 2px solid var(--ink); }
  details { border-bottom: 1px solid var(--rule); }
  summary {
    cursor: pointer; list-style: none; min-height: 56px; display: flex; align-items: center; justify-content: space-between; gap: 1rem;
    font: 600 1.0625rem/1.3 var(--body); padding: 0.5rem 0;
  }
  summary::-webkit-details-marker { display: none; }
  summary::after { content: '+'; font: 700 1.25rem/1 var(--mono); }
  details[open] summary::after { content: '-'; }
  details p { padding: 0 0 1rem; max-width: 62ch; color: var(--ink-2); }
</style>

<script>
  import { isTweetUrl } from '../lib/api';
  import { loadPreview, type PreviewParams } from '../components/preview';

  // Hero: describe / photo -> custom render; tweet link -> Tweet Trophy builder
  const form = document.getElementById('hero-form') as HTMLFormElement;
  const input = document.getElementById('hero-input') as HTMLTextAreaElement;
  const photo = document.getElementById('hero-photo') as HTMLInputElement;
  const go = document.getElementById('hero-go') as HTMLButtonElement;
  const err = document.getElementById('hero-err')!;
  const msg = document.getElementById('hero-msg')!;
  const stage = document.getElementById('hero-stage')!;
  const conceptImg = document.getElementById('hero-concept') as HTMLImageElement;
  photo.addEventListener('change', () => {
    document.getElementById('photo-label')!.textContent = photo.files?.[0] ? `Photo: ${photo.files[0].name.slice(0, 24)}` : '+ Add a photo';
  });
  document.getElementById('chips')!.addEventListener('click', (e) => {
    const c = (e.target as HTMLElement).closest('.chip'); if (c) { input.value = c.textContent || ''; input.focus(); }
  });
  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    err.textContent = '';
    const q = input.value.trim();
    const file = photo.files?.[0];
    const utm = new URLSearchParams();
    for (const [k, v] of new URLSearchParams(location.search)) if (k.startsWith('utm_')) utm.set(k, v);
    if (q && isTweetUrl(q) && !file) { utm.set('product', 'tweet'); utm.set('url', q); location.href = `/make?${utm}`; return; }
    if (!q && !file) { err.textContent = 'Describe what you want, or add a photo.'; return; }
    if (file && file.size > 4 * 1024 * 1024) { err.textContent = 'Photos must be under 4 MB.'; return; }
    go.disabled = true;
    const t0 = Date.now();
    const tick = setInterval(() => { go.textContent = `Making your model… ${Math.round((Date.now() - t0) / 1000)}s`; }, 500);
    try {
      hero?.destroy(); hero = null; delete stage.dataset.ready;
      msg.textContent = 'Drawing your idea…';
      const fd = new FormData();
      if (q) fd.set('prompt', q);
      if (file) fd.set('photo', file);
      const res = await fetch('/api/render', { method: 'POST', body: fd });
      const j = await res.json().catch(() => ({}));
      if (!res.ok) throw new Error(j.error || 'Something went wrong. Try again.');
      conceptImg.src = j.conceptUrl; conceptImg.hidden = false;
      msg.textContent = 'Sculpting it in 3D (about 20 seconds)…';
      for (let i = 0; i < 120; i++) {
        await new Promise((r) => setTimeout(r, 1500));
        const s = await fetch(`/api/render/${encodeURIComponent(j.id)}`).then((r) => r.json()).catch(() => null);
        if (s?.state === 'done') { utm.set('id', j.id); location.href = `/r?${utm}`; return; }
        if (s?.state === 'failed') throw new Error("The 3D step didn't work for that one. Try rewording it.");
      }
      throw new Error('This is taking unusually long. Try again in a minute.');
    } catch (ex) {
      err.textContent = ex instanceof Error ? ex.message : 'Something went wrong.';
      msg.textContent = '';
    } finally {
      clearInterval(tick); go.disabled = false; go.textContent = 'Make my 3D model';
    }
  });

  // Hero object: a real customer-style render, in the same viewer as /r
  let hero: { destroy(): void } | null = null;
  import('../lib/figure-viewer').then(async ({ mountFigureViewer }) => {
    const v = mountFigureViewer(stage);
    hero = v;
    v.setColour('#c9a24b');
    try { await v.load('/examples/dog.glb'); } catch { msg.textContent = ''; }
  });

  // Product shelf: render each object once with snapshot(), one at a time, then free the GL context.
  const samples: Record<string, PreviewParams> = {
    tweet: { product: 'tweet', colour: 'black', author_name: 'Trove', handle: 'trovefactory', text: 'We 3D print your receipts.' },
    milestone: { product: 'milestone', colour: 'gold', number: '$10,000', label: 'MRR' },
    fullcolour: { product: 'fullcolour', colour: 'white', name: 'Trove' },
    team: { product: 'team', colour: 'blue', team: 'Trove', subline: 'Zero-Human Hackathon 2026' },
  };
  async function renderShelf() {
    const mod = await loadPreview();
    if (!mod) return;
    const host = document.createElement('div');
    host.style.cssText = 'position:fixed;left:-10000px;top:0;width:640px;height:800px;pointer-events:none;';
    host.setAttribute('aria-hidden', 'true');
    document.body.appendChild(host);
    for (const slot of document.querySelectorAll<HTMLElement>('[data-snap]')) {
      const params = samples[slot.dataset.snap!];
      try {
        const h = mod.mountPreview(host, params);
        await new Promise((r) => setTimeout(r, 400));
        const blob = await h.snapshot();
        h.destroy();
        const img = document.createElement('img');
        img.src = URL.createObjectURL(blob);
        img.alt = slot.textContent?.trim() || '';
        img.loading = 'lazy';
        slot.appendChild(img);
        slot.dataset.ready = '1';
      } catch (e) {
        console.warn('shelf render failed', e);
      }
      host.replaceChildren();
    }
    host.remove();
  }
  const shelf = document.querySelector('.shelf');
  if (shelf) {
    const io = new IntersectionObserver((entries) => {
      if (entries.some((e) => e.isIntersecting)) { io.disconnect(); renderShelf(); }
    }, { rootMargin: '300px' });
    io.observe(shelf);
  }
</script>
