# Copy to backend/deploy/.env and fill in. Never commit .env. Empty = feature off / mock.
# Generate tokens with: openssl rand -hex 32

# ---- shared ----
MCP_TOKEN=                     # required. Any random string; bots use it to reach the MCP server
SITE_URL=                      # https://<your Vercel domain>, no trailing slash
SITE_ADMIN_TOKEN=              # same value as ADMIN_TOKEN in the Vercel project env vars

# ---- orders (receipts-worker + mcp) ----
RECEIPTS_MOCK=                 # 1 = fake Whop/Slant/Craftcloud (default when their keys are missing)
WHOP_API_KEY=                  # Whop dashboard > Developer > API keys (company key)
WHOP_COMPANY_ID=               # Whop dashboard URL / Developer page, starts with biz_
SLANT_API_KEY=                 # Slant 3D dashboard > API
SLANT_PLATFORM_ID=             # Slant 3D dashboard > API (platform id)
CRAFTCLOUD_API_KEY=            # Craftcloud (All3DP) partner/API settings

# ---- marketing tools (mcp only) ----
X_BEARER_TOKEN=                # developer.x.com > your app > Keys and tokens > Bearer token
X_BRAND_HANDLE=receipts        # the brand X handle, without @
X_AUTOREPLY_MENTIONS=0         # 1 = auto-reply ONLY to "@<brand> print this" mentions
X_USER_TOKEN=                  # OAuth 2.0 user token for the brand account (needed only for mention replies)
EXA_API_KEY=                   # dashboard.exa.ai > API keys
SOLARI_API_KEY=                # Solari dashboard (docs.getsolari.com)
SOLARI_CDP_URL=                # optional: a Solari session CDP websocket URL (skips session creation)
ADS_DAILY_CAP_USD=50           # hard cap on drafted daily ad budgets across Whop Ads + X Ads

# ---- Hermes fleet (hermes only). Sign-in: SETUP-MAC.md step 5 (`hermes auth add ...`) ----
CLAUDE_PROVIDER=anthropic      # Hermes provider for ceo, designer, closer (Claude account / Claude Code login)
CLAUDE_MODEL=claude-sonnet-4-6
CODEX_PROVIDER=openai-codex    # Hermes provider for scout, ads, production, hiring, finance (ChatGPT login)
CODEX_MODEL=gpt-5.5            # a ChatGPT account rejects gpt-5-codex / gpt-5.x-codex ids
# Optional per-bot model overrides (empty = the engine default above)
CEO_MODEL=
SCOUT_MODEL=
DESIGNER_MODEL=
CLOSER_MODEL=
ADS_MODEL=
PRODUCTION_MODEL=
HIRING_MODEL=
FINANCE_MODEL=
